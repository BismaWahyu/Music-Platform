{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "SwayTune",
  "version": "0.1.0",
  "identifier": "com.senandung.app",
  "build": {
    "beforeDevCommand": "npm run dev --workspace=packages/shell",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build --workspace=packages/shell",
    "frontendDist": "../packages/shell/dist"
  },
  "app": {
    "windows": [
      {
        "title": "SwayTune",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {}
}
