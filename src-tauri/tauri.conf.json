{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Senandung",
  "version": "0.1.0",
  "identifier": "com.senandung.app",
  "build": {
    "beforeDevCommand": "npm run dev --workspace=packages/shell",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build --workspace=packages/shell",
    "frontendDist": "../packages/shell/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Senandung - Music Platform",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  },
  "plugins": {}
}
